<ui:FluentWindow x:Class="WrestlingGameMuseum.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:WrestlingGameMuseum.Views"
                 xmlns:local="clr-namespace:WrestlingGameMuseum"
                 Title="Wrestling Game Museum" Width="1280" Height="820" MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="None"
                 Background="{StaticResource Museum.PageGradientBrush}"
                 PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Wrestling Game Museum" />
    <Grid Grid.Row="1">
      <views:IndexView Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}" />
      <views:ExhibitView Visibility="{Binding IsViewingExhibit, Converter={StaticResource BoolToVisibility}}" />
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,28,0" CornerRadius="7"
              Background="#FF24170E" Padding="12,7"
              Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}">
        <TextBlock Text="{Binding Status}" MaxWidth="470" TextWrapping="Wrap" FontSize="12" Foreground="#FFFFCD77" />
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
