<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!--
    The museum look, taken from the Fire Pro Museum: a dark, warm "arena at night".
    Nothing readable sits directly on the page background; it sits on a toolbar, band or card.
  -->

  <!-- Gold wherever WPF-UI would use the Windows accent. -->
  <Color x:Key="SystemAccentColor">#E1A93A</Color>
  <Color x:Key="SystemAccentColorPrimary">#F2C35E</Color>
  <Color x:Key="SystemAccentColorSecondary">#E1A93A</Color>
  <Color x:Key="SystemAccentColorTertiary">#D08A2A</Color>
  <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#E1A93A" />
  <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#F2C35E" />
  <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#E1A93A" />
  <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#D08A2A" />
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E1A93A" />

  <!-- Brighter secondary/tertiary text than WPF-UI's dark defaults, as in the Manager. -->
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFDADADA" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FFB9B9B9" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1E1E1E" />
  <SolidColorBrush x:Key="ButtonBackground" Color="#FF201B18" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF2B2420" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF181412" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#664B596D" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B3E1B84B" />

  <!-- Tokens -->
  <SolidColorBrush x:Key="Museum.PageBackgroundBrush" Color="#FF0C0B0B" />
  <LinearGradientBrush x:Key="Museum.PageGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF100D0C" Offset="0" />
    <GradientStop Color="#FF0A0909" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Museum.BandBrush" Color="#D91E1C1A" />
  <SolidColorBrush x:Key="Museum.TileBrush" Color="#ED100D0D" />
  <SolidColorBrush x:Key="Museum.TileBorderBrush" Color="#A568421D" />
  <SolidColorBrush x:Key="Museum.TileHoverBorderBrush" Color="#FFFFBE65" />
  <SolidColorBrush x:Key="Museum.TileHoverBrush" Color="#FF261A14" />
  <SolidColorBrush x:Key="Museum.TileFocusBorderBrush" Color="#FFFFD787" />
  <SolidColorBrush x:Key="Museum.GoldBrush" Color="#FFFFC977" />
  <SolidColorBrush x:Key="Museum.YearGoldBrush" Color="#FFFFCD76" />
  <SolidColorBrush x:Key="Museum.YearChipBrush" Color="#33FFC977" />
  <SolidColorBrush x:Key="Museum.FactChipBrush" Color="#1FFFFFFF" />
  <LinearGradientBrush x:Key="Museum.ShelfBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF0C0B0B" Offset="0" />
    <GradientStop Color="#FF1A1512" Offset="0.92" />
    <GradientStop Color="#FF3A2A1C" Offset="1" />
  </LinearGradientBrush>

  <!-- Type -->
  <FontFamily x:Key="Museum.SerifFont">Georgia</FontFamily>
  <FontFamily x:Key="Museum.HeadingFont">Segoe UI Variable Display, Segoe UI</FontFamily>

  <!-- Slim dark toolbar at the top of each view. -->
  <Style x:Key="ToolbarBand" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Museum.BandBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Dark section band: one per shelf, and the base of exhibit cards. -->
  <Style x:Key="SectionBand" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Museum.BandBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,9" />
  </Style>

  <Style x:Key="BandTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Museum.SerifFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{StaticResource Museum.GoldBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="BandNote" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="GoldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Museum.GoldBrush}" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="ExhibitHeading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Museum.HeadingFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="YearChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Museum.YearChipBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,2" />
  </Style>

  <Style x:Key="FactChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Museum.FactChipBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>

  <!-- A compact icon-only toolbar button: always give it a ToolTip and AutomationProperties.Name. -->
  <Style x:Key="ToolbarIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="3,0,0,0" />
    <Setter Property="Appearance" Value="Secondary" />
  </Style>

  <!-- Tile card on the shelf: whole card is the button. -->
  <Style x:Key="MuseumTile" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Museum.TileBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Museum.TileBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" CornerRadius="11" ClipToBounds="True"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Museum.TileHoverBorderBrush}" />
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Museum.TileHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Museum.TileFocusBorderBrush}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Row container for the virtualised index: no selection chrome, not focusable. -->
  <Style x:Key="PlainRow" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
